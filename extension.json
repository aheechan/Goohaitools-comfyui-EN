      "dst": "custom_nodes/Goohaitools-comfyui/fonts/"
    },
    {
      "src": "web/",
      "dst": "custom_nodes/Goohaitools-comfyui/web/"
    },
    {
      "src": "locales/",
      "dst": "custom_nodes/Goohaitools-comfyui/locales/"
    },
    {
      "src": "requirements.txt",
      "dst": "custom_nodes/Goohaitools-comfyui/"
    },
    {
      "src": "shape_predictor_5_face_landmarks.dat",
      "dst": "custom_nodes/Goohaitools-comfyui/"
    },
    {
      "src": "__init__.py",
      "dst": "custom_nodes/Goohaitools-comfyui/"
    },
    {
      "src": "extension.json",
      "dst": "custom_nodes/Goohaitools-comfyui/"
    },
    {
      "src": ".gitignore",
      "dst": "custom_nodes/Goohaitools-comfyui/"
    }
  ]
}
